# MAPS_API_KEY: Required for live Google Maps tiles & Directions API.
# Configure your Google Maps API key in the Secrets panel in AI Studio.
# Without a real key, KG Taxi runs seamlessly with its interactive vector map of Kyrgyzstan.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional Kyrgyzstan Bank Acquiring / Split-Payout Webhook (e.g. MBank Business, Freedom Pay, PayBox, Finik).
# Configure these in the AI Studio Secrets panel to send real automated split-payout HTTP requests.
PAYMENT_GATEWAY_WEBHOOK_URL=YOUR_PAYMENT_GATEWAY_WEBHOOK_URL
PAYMENT_GATEWAY_API_KEY=YOUR_PAYMENT_GATEWAY_API_KEY

