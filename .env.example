# MAPS_API_KEY: Required for live Google Maps tiles & Directions API.
# Copy this file to .env and put your real key there (.env is not committed to git).
# Without a real key, KG Taxi runs with its interactive vector map of Kyrgyzstan.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Payment gateway keys (MBank Business, Freedom Pay, PayBox, Finik) do NOT go here.
# Everything in this file ends up inside the APK, where anyone can read it.
# They belong on the server (Firebase Cloud Functions secrets), see README-SECURITY.md.
