rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('homeAddress' in data) || (data.homeAddress is string && data.homeAddress.size() <= 160)) &&
             (!('workAddress' in data) || (data.workAddress is string && data.workAddress.size() <= 160)) &&
             data.paymentMethod in ['CASH', 'MBANK', 'ODENGI', 'ELCART', 'CARD'] &&
             data.kgOneActive is bool &&
             data.businessProfileActive is bool &&
             (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 100)) &&
             (!('companyEmail' in data) || (data.companyEmail is string && data.companyEmail.size() <= 120)) &&
             data.bonusPoints is int && data.bonusPoints >= 0 && data.bonusPoints <= 1000000 &&
             data.preferredCity is string && data.preferredCity.size() >= 1 && data.preferredCity.size() <= 50 &&
             data.language in ['RU', 'KG', 'EN'] &&
             data.darkTheme is bool &&
             data.soundEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTripRecord(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.serviceType in ['TAXI', 'HOURLY', 'COURIER', 'CARGO', 'INTERCITY', 'FOOD'] &&
             data.tariffName is string && data.tariffName.size() >= 1 && data.tariffName.size() <= 60 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 50 &&
             data.pickupAddress is string && data.pickupAddress.size() >= 1 && data.pickupAddress.size() <= 200 &&
             data.dropoffAddress is string && data.dropoffAddress.size() >= 1 && data.dropoffAddress.size() <= 200 &&
             data.distanceKm is number && data.distanceKm >= 0 && data.distanceKm <= 5000 &&
             data.durationMin is int && data.durationMin >= 0 && data.durationMin <= 2000 &&
             data.totalPriceSom is int && data.totalPriceSom >= 0 && data.totalPriceSom <= 1000000 &&
             data.paymentMethod is string && data.paymentMethod.size() >= 1 && data.paymentMethod.size() <= 30 &&
             data.status in ['SEARCHING', 'ASSIGNED', 'ARRIVED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'] &&
             (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 80)) &&
             (!('driverCar' in data) || (data.driverCar is string && data.driverCar.size() <= 80)) &&
             data.safetyPin is string && data.safetyPin.size() >= 4 && data.safetyPin.size() <= 6 &&
             data.rating is int && data.rating >= 0 && data.rating <= 5 &&
             data.tipSom is int && data.tipSom >= 0 && data.tipSom <= 100000 &&
             data.businessTrip is bool &&
             (!('lostItemNote' in data) || (data.lostItemNote is string && data.lostItemNote.size() <= 300)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSavedPlace(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 60 &&
             data.address is string && data.address.size() >= 1 && data.address.size() <= 200 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 50 &&
             data.lat is number && data.lat >= -90 && data.lat <= 90 &&
             data.lng is number && data.lng >= -180 && data.lng <= 180 &&
             data.category in ['HOME', 'WORK', 'FAVORITE', 'ROUTE'] &&
             data.rating is number && data.rating >= 0 && data.rating <= 5 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFamilyMember(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.relation is string && data.relation.size() >= 1 && data.relation.size() <= 40 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
             data.monthlyLimitSom is int && data.monthlyLimitSom >= 0 && data.monthlyLimitSom <= 500000 &&
             data.teenControlEnabled is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVehicleMaintenance(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.vehicleName is string && data.vehicleName.size() >= 1 && data.vehicleName.size() <= 80 &&
             data.serviceTitle is string && data.serviceTitle.size() >= 1 && data.serviceTitle.size() <= 100 &&
             data.dueMileageKm is int && data.dueMileageKm >= 0 && data.dueMileageKm <= 2000000 &&
             data.currentMileageKm is int && data.currentMileageKm >= 0 && data.currentMileageKm <= 2000000 &&
             data.fuelLitersPer100Km is number && data.fuelLitersPer100Km >= 0 && data.fuelLitersPer100Km <= 50 &&
             data.completed is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // --- COLLECTION RULES ---
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'paymentMethod', 'kgOneActive',
                         'businessProfileActive', 'bonusPoints', 'preferredCity',
                         'language', 'darkTheme', 'soundEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'phone', 'email', 'homeAddress', 'workAddress',
                         'paymentMethod', 'kgOneActive', 'businessProfileActive', 'companyName',
                         'companyEmail', 'bonusPoints', 'preferredCity', 'language',
                         'darkTheme', 'soundEnabled', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'phone', 'email', 'homeAddress', 'workAddress',
                         'paymentMethod', 'kgOneActive', 'businessProfileActive', 'companyName',
                         'companyEmail', 'bonusPoints', 'preferredCity', 'language',
                         'darkTheme', 'soundEnabled', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /trips/{tripId} {
        allow get: if isOwner(userId) && isValidId(tripId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(tripId) &&
                         incoming().keys().hasAll([
                           'userId', 'serviceType', 'tariffName', 'city', 'pickupAddress',
                           'dropoffAddress', 'distanceKm', 'durationMin', 'totalPriceSom',
                           'paymentMethod', 'status', 'safetyPin', 'rating', 'tipSom',
                           'businessTrip', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'serviceType', 'tariffName', 'city', 'pickupAddress',
                           'dropoffAddress', 'distanceKm', 'durationMin', 'totalPriceSom',
                           'paymentMethod', 'status', 'driverName', 'driverCar', 'safetyPin',
                           'rating', 'tipSom', 'businessTrip', 'lostItemNote', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTripRecord(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(tripId) &&
                         isValidTripRecord(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           // Action 1: Active trip lifecycle or in-trip destination edit
                           (!(existing().status in ['COMPLETED', 'CANCELLED']) &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'status', 'dropoffAddress', 'distanceKm', 'durationMin',
                               'totalPriceSom', 'driverName', 'driverCar', 'updatedAt'
                             ])) ||
                           // Action 2: Post-trip rating, tip, or lost item report (terminal state locked)
                           (existing().status in ['COMPLETED', 'CANCELLED'] &&
                             incoming().status == existing().status &&
                             incoming().diff(existing()).affectedKeys().hasOnly([
                               'rating', 'tipSom', 'lostItemNote', 'updatedAt'
                             ]))
                         );

        allow delete: if isOwner(userId) && isValidId(tripId);
      }

      match /saved_places/{placeId} {
        allow get: if isOwner(userId) && isValidId(placeId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(placeId) &&
                         incoming().keys().hasAll([
                           'userId', 'label', 'address', 'city', 'lat', 'lng',
                           'category', 'rating', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'label', 'address', 'city', 'lat', 'lng',
                           'category', 'rating', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidSavedPlace(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(placeId) &&
                         isValidSavedPlace(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'label', 'address', 'city', 'lat', 'lng', 'category', 'rating', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(placeId);
      }

      match /family_members/{memberId} {
        allow get: if isOwner(userId) && isValidId(memberId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(memberId) &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'relation', 'monthlyLimitSom',
                           'teenControlEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'relation', 'phone', 'monthlyLimitSom',
                           'teenControlEnabled', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFamilyMember(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(memberId) &&
                         isValidFamilyMember(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'relation', 'phone', 'monthlyLimitSom', 'teenControlEnabled', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(memberId);
      }

      match /maintenance_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(logId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(logId) &&
                         incoming().keys().hasAll([
                           'userId', 'vehicleName', 'serviceTitle', 'dueMileageKm',
                           'currentMileageKm', 'fuelLitersPer100Km', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'vehicleName', 'serviceTitle', 'dueMileageKm',
                           'currentMileageKm', 'fuelLitersPer100Km', 'completed', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidVehicleMaintenance(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(logId) &&
                         isValidVehicleMaintenance(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'vehicleName', 'serviceTitle', 'dueMileageKm',
                           'currentMileageKm', 'fuelLitersPer100Km', 'completed', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }

    // =====================================================================
    // ROLES, SOS AND SHARED RIDES
    // =====================================================================

    // roles/{uid} = { role: 'driver' | 'dispatcher' | 'admin' }
    // Nobody can give themselves a role from the app. Roles are set by the owner in the
    // Firebase console (or later by a Cloud Function after checking driver documents).
    function roleOf(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid))
        ? get(/databases/$(database)/documents/roles/$(uid)).data.role
        : 'passenger';
    }

    function hasRole(r) {
      return isSignedIn() && roleOf(request.auth.uid) == r;
    }

    function isDriver() {
      return hasRole('driver');
    }

    function isDispatcher() {
      return hasRole('dispatcher') || hasRole('admin');
    }

    function onlyChanged(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    match /roles/{uid} {
      allow get: if isOwner(uid) || isDispatcher();
      allow list: if hasRole('admin');
      allow write: if false;
    }

    // Push tokens: each user writes only their own; the server (Admin SDK) reads them.
    match /device_tokens/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create, update: if isOwner(uid) &&
                               incoming().keys().hasOnly(['userId', 'token', 'city', 'driverOnline', 'updatedAt']) &&
                               incoming().userId == uid &&
                               incoming().token is string && incoming().token.size() <= 4096 &&
                               incoming().city is string && incoming().city.size() <= 50 &&
                               incoming().driverOnline is bool &&
                               isValidTimestamp(incoming().updatedAt);
      allow delete: if isOwner(uid);
    }

    // Driver applications: a person applies once (and may correct it while pending);
    // the owner reviews it and gives the role in roles/{uid}.
    match /driver_applications/{uid} {
      allow get: if isOwner(uid) || isDispatcher();
      allow list: if isDispatcher();
      allow create, update: if isOwner(uid) &&
                               (resource == null || existing().status == 'pending') &&
                               incoming().keys().hasOnly(['userId', 'fullName', 'phone', 'city', 'car', 'plate',
                                                          'licenseNumber', 'experienceYears', 'payPhone',
                                                          'status', 'createdAt']) &&
                               incoming().userId == uid &&
                               incoming().status == 'pending' &&
                               incoming().fullName is string && incoming().fullName.size() >= 2 && incoming().fullName.size() <= 80 &&
                               incoming().phone is string && incoming().phone.size() >= 6 && incoming().phone.size() <= 20 &&
                               incoming().city is string && incoming().city.size() <= 50 &&
                               incoming().car is string && incoming().car.size() >= 2 && incoming().car.size() <= 80 &&
                               incoming().plate is string && incoming().plate.size() >= 4 && incoming().plate.size() <= 20 &&
                               incoming().licenseNumber is string && incoming().licenseNumber.size() >= 4 && incoming().licenseNumber.size() <= 30 &&
                               incoming().experienceYears is int && incoming().experienceYears >= 0 && incoming().experienceYears <= 60 &&
                               incoming().payPhone is string && incoming().payPhone.size() <= 20 &&
                               isValidTimestamp(incoming().createdAt);
      // Approve / reject is done by the owner in the Firebase console.
      allow delete: if isOwner(uid) && existing().status == 'pending';
    }

    // SOS alerts: the sender creates, dispatchers read and resolve.
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn() &&
                       isValidId(alertId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'lat', 'lng', 'address', 'city', 'resolved', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'lat', 'lng', 'address', 'city', 'tripId',
                                                  'driverName', 'carInfo', 'resolved', 'createdAt']) &&
                       incoming().lat is number && incoming().lat >= -90 && incoming().lat <= 90 &&
                       incoming().lng is number && incoming().lng >= -180 && incoming().lng <= 180 &&
                       incoming().address is string && incoming().address.size() <= 200 &&
                       incoming().city is string && incoming().city.size() <= 50 &&
                       incoming().resolved == false &&
                       isValidTimestamp(incoming().createdAt);
      allow get: if isDispatcher() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isDispatcher();
      allow update: if isDispatcher() &&
                       onlyChanged(['resolved', 'resolvedBy', 'resolvedAt']) &&
                       incoming().resolved == true &&
                       incoming().resolvedBy == request.auth.uid;
      allow delete: if false;
    }

    // Shared ride orders: a passenger creates one, drivers see open orders and accept them.
    // Status flow: SEARCHING -> ASSIGNED -> ARRIVED -> IN_PROGRESS -> COMPLETED, or CANCELLED.
    function isValidRideCreate(data) {
      return data.passengerId == request.auth.uid &&
             data.status == 'SEARCHING' &&
             data.driverId == null &&
             data.serviceType in ['TAXI', 'INTERCITY'] &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 50 &&
             data.pickupAddress is string && data.pickupAddress.size() >= 1 && data.pickupAddress.size() <= 200 &&
             data.dropoffAddress is string && data.dropoffAddress.size() >= 1 && data.dropoffAddress.size() <= 200 &&
             data.pickupLat is number && data.pickupLat >= -90 && data.pickupLat <= 90 &&
             data.pickupLng is number && data.pickupLng >= -180 && data.pickupLng <= 180 &&
             data.dropoffLat is number && data.dropoffLat >= -90 && data.dropoffLat <= 90 &&
             data.dropoffLng is number && data.dropoffLng >= -180 && data.dropoffLng <= 180 &&
             data.priceSom is int && data.priceSom > 0 && data.priceSom <= 100000 &&
             data.paymentMethod == 'CASH' &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    match /rides/{rideId} {
      allow create: if isSignedIn() &&
                       isValidId(rideId) &&
                       incoming().keys().hasAll(['passengerId', 'status', 'driverId', 'serviceType', 'city',
                                                 'pickupAddress', 'dropoffAddress', 'pickupLat', 'pickupLng',
                                                 'dropoffLat', 'dropoffLng', 'priceSom', 'paymentMethod',
                                                 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['passengerId', 'passengerName', 'status', 'driverId', 'serviceType',
                                                  'city', 'pickupAddress', 'dropoffAddress', 'pickupLat', 'pickupLng',
                                                  'dropoffLat', 'dropoffLng', 'priceSom', 'paymentMethod', 'comment',
                                                  'createdAt', 'updatedAt']) &&
                       isValidRideCreate(incoming());

      allow get: if isSignedIn() && (
                    existing().passengerId == request.auth.uid ||
                    existing().driverId == request.auth.uid ||
                    (isDriver() && existing().status == 'SEARCHING') ||
                    isDispatcher());

      // Drivers may list only open orders (their query must filter status == 'SEARCHING').
      allow list: if isDispatcher() ||
                    (isDriver() && resource.data.status == 'SEARCHING') ||
                    (isSignedIn() && (resource.data.passengerId == request.auth.uid ||
                                      resource.data.driverId == request.auth.uid));

      allow update: if isSignedIn() && isValidTimestamp(incoming().updatedAt) && (
        // The passenger cancels before the trip starts.
        (existing().passengerId == request.auth.uid &&
         existing().status in ['SEARCHING', 'ASSIGNED', 'ARRIVED'] &&
         incoming().status == 'CANCELLED' &&
         onlyChanged(['status', 'updatedAt'])) ||
        // A driver takes an open order.
        (isDriver() &&
         existing().status == 'SEARCHING' &&
         existing().driverId == null &&
         incoming().status == 'ASSIGNED' &&
         incoming().driverId == request.auth.uid &&
         onlyChanged(['status', 'driverId', 'driverName', 'driverCar', 'driverPlate', 'driverPayPhone', 'updatedAt'])) ||
        // The assigned driver moves the trip forward or cancels it.
        (isDriver() &&
         existing().driverId == request.auth.uid &&
         ((existing().status == 'ASSIGNED' && incoming().status in ['ARRIVED', 'CANCELLED']) ||
          (existing().status == 'ARRIVED' && incoming().status in ['IN_PROGRESS', 'CANCELLED']) ||
          (existing().status == 'IN_PROGRESS' && incoming().status == 'COMPLETED')) &&
         onlyChanged(['status', 'updatedAt', 'driverLat', 'driverLng'])) ||
        // The assigned driver shares live position during the trip.
        (isDriver() &&
         existing().driverId == request.auth.uid &&
         existing().status in ['ASSIGNED', 'ARRIVED', 'IN_PROGRESS'] &&
         incoming().status == existing().status &&
         incoming().driverLat is number && incoming().driverLng is number &&
         onlyChanged(['driverLat', 'driverLng', 'updatedAt']))
      );

      allow delete: if false;

      // Chat between the passenger and the assigned driver of this ride.
      match /messages/{msgId} {
        allow read: if isRideParticipant(rideId) || isDispatcher();
        allow create: if isRideParticipant(rideId) &&
                         incoming().keys().hasOnly(['senderId', 'text', 'createdAt']) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().text is string &&
                         incoming().text.size() >= 1 && incoming().text.size() <= 500 &&
                         isValidTimestamp(incoming().createdAt);
        allow update, delete: if false;
      }
    }

    function isRideParticipant(rideId) {
      let ride = get(/databases/$(database)/documents/rides/$(rideId)).data;
      return isSignedIn() &&
             (ride.passengerId == request.auth.uid || ride.driverId == request.auth.uid);
    }
  }
}
